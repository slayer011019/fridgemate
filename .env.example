# Frontend (Vite / Vercel)
# Backend API base URL. Required for deployed frontend.
# Example: https://your-api.up.railway.app/api
VITE_API_URL=
# Legacy frontend alias. Leave empty unless older deployment config expects it.
VITE_API_BASE_URL=

# Toggle browser OCR import on or off.
VITE_ENABLE_OCR=true

# Optional Sentry DSN for frontend error monitoring.
VITE_SENTRY_DSN=

# Required whenever the backend is enabled.
JWT_SECRET=
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d
JWT_ISSUER=fridgemate-api
JWT_AUDIENCE=fridgemate-client
ACCESS_TOKEN_COOKIE_NAME=fridgemate_access
REFRESH_TOKEN_COOKIE_NAME=fridgemate_refresh
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Lax
REDIS_URL=redis://localhost:6379
AUTH_REDIS_PREFIX=fridgemate:auth

# Express API
# Local backend port.
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

# Optional integrations
# Enables AI recipe suggestions when the backend is running.
ANTHROPIC_API_KEY=
# Server/local script only. Never expose the Supabase service role key with a VITE_ prefix.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
FOODSAFETY_API_KEY=
# Enables OCR correction vector suggestions when the backend is running.
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=512

# Optional recipe preprocessing and pgvector recommendation support.
# OPENAI_API_KEY above is also used for recipe embedding generation.
# Must match the recipe_embeddings.embedding vector dimension in the migration.
RECIPE_EMBEDDING_MODEL=text-embedding-3-small
RECIPE_EMBEDDING_DIMENSIONS=1536

# Database (backend local/dev or production)
# Replace the placeholders below with the connection string from your DB provider.
# Local example:
# DATABASE_URL="postgresql://DB_USER:DB_PASSWORD@localhost:5432/fridgemate?schema=public"
# DIRECT_URL="postgresql://DB_USER:DB_PASSWORD@localhost:5432/fridgemate?schema=public"
# Hosted example:
# DATABASE_URL="postgresql://DB_USER:DB_PASSWORD@DB_HOST:5432/fridgemate?sslmode=require&schema=public"
# DIRECT_URL="postgresql://DB_USER:DB_PASSWORD@DB_HOST:5432/fridgemate?sslmode=require&schema=public"
# Supabase pooler example:
# DATABASE_URL="postgresql://postgres.PROJECT_REF:DB_PASSWORD@aws-1-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.PROJECT_REF:DB_PASSWORD@aws-1-ap-northeast-1.pooler.supabase.com:5432/postgres"
DATABASE_URL="postgresql://DB_USER:DB_PASSWORD@DB_HOST:5432/fridgemate?schema=public"
DIRECT_URL="postgresql://DB_USER:DB_PASSWORD@DB_HOST:5432/fridgemate?schema=public"
