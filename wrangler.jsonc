{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fridgemate-api",
  "main": "server/src/worker.js",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "api.xn--wh1bs8l5xa003adme.com/*",
      "zone_name": "xn--wh1bs8l5xa003adme.com"
    }
  ],
  "observability": { "enabled": true },
  "kv_namespaces": [
    {
      "binding": "AUTH_KV",
      "id": "3164069f15a04b56848f27d3f2153be0"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "AUTH_RATE_LIMITER",
        "class_name": "AuthRateLimiter"
      }
    ]
  },
  "exports": {
    "AuthRateLimiter": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "8aae49108a184e3abf5523b0106af5d9"
    }
  ],
  "vars": {
    "NODE_ENV": "production",
    "CLIENT_ORIGIN": "https://xn--wh1bs8l5xa003adme.com",
    "ALLOWED_ORIGINS": "https://xn--wh1bs8l5xa003adme.com,https://www.xn--wh1bs8l5xa003adme.com",
    "ACCESS_TOKEN_COOKIE_NAME": "__Host-fridgemate_access",
    "REFRESH_TOKEN_COOKIE_NAME": "__Host-fridgemate_refresh",
    "AUTH_COOKIE_SECURE": "true",
    "AUTH_COOKIE_SAME_SITE": "Lax",
    "JWT_EXPIRES_IN": "15m",
    "REFRESH_TOKEN_EXPIRES_IN": "30d",
    "RECIPE_EMBEDDING_MODEL": "text-embedding-3-small",
    "RECIPE_EMBEDDING_DIMENSIONS": "1536"
  }
}
