{
  "name": "fridgemate",
  "description": "A local-first fridge and pantry tracker with expiry alerts, recipe recommendations, and OCR-based ingredient import.",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:client": "vite",
    "dev:server": "node --watch --env-file=.env server/src/index.js",
    "lint": "eslint .",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "server": "node server/src/index.js",
    "start": "node server/src/index.js",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "import-corrections:backfill": "node --env-file=.env scripts/backfillImportCorrectionEmbeddings.js"
  },
  "dependencies": {
    "@prisma/client": "^6.6.0",
    "@sentry/react": "^10.49.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1",
    "redis": "^5.12.1",
    "tesseract.js": "^6.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.4.0",
    "jsdom": "^29.0.1",
    "postcss": "^8.4.49",
    "prettier": "^3.8.1",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.17",
    "vite": "^8.0.3",
    "vitest": "^4.1.2"
  }
}
