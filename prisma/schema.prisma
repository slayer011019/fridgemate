generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                String             @id @default(cuid())
  email             String             @unique
  emailNormalized   String             @unique
  passwordHash      String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  ingredients       Ingredient[]
  authSessions      AuthSession[]
  importCorrections ImportCorrection[]
  recommendationEvents RecommendationEvent[]
  menuDecisions      MenuDecision[]
  pantryOwnerships   PantryOwnership[]
  preference         UserPreference?
  productEvents      ProductEvent[]
}

model AuthSession {
  id                  String    @id @default(cuid())
  tokenHash           String    @unique
  expiresAt           DateTime
  revokedAt           DateTime?
  replacedBySessionId String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([userId, revokedAt])
}

model Ingredient {
  id           String   @id @default(cuid())
  clientId     String
  name         String?
  category     String?
  storageType  String?
  quantity     String?
  purchaseDate String?
  expiryDate   String?
  memo         String?
  consumed     Boolean? @default(false)
  createdAt    DateTime? @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([expiryDate])
  @@index([category])
  @@index([storageType])
  @@index([userId, createdAt])
  @@index([userId, updatedAt])
  @@index([userId, deletedAt])
  @@unique([userId, clientId])
}

model Recipe {
  id              String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  externalId      String             @unique @map("external_id")
  name            String
  cookingMethod   String?            @map("cooking_method")
  dishType        String?            @map("dish_type")
  servingWeight   String?            @map("serving_weight")
  calories        Decimal?           @db.Decimal
  carbohydrate    Decimal?           @db.Decimal
  protein         Decimal?           @db.Decimal
  fat             Decimal?           @db.Decimal
  sodium          Decimal?           @db.Decimal
  hashTag         String?            @map("hash_tag")
  imageSmallUrl   String?            @map("image_small_url")
  imageLargeUrl   String?            @map("image_large_url")
  ingredientsText String?            @map("ingredients_text")
  steps           Json               @default(dbgenerated("'[]'::jsonb"))
  sodiumTip       String?            @map("sodium_tip")
  source          String             @default("MFDS_COOKRCP01")
  raw             Json?
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  ingredients     RecipeIngredient[]
  embeddings      RecipeEmbedding[]
  menuDecisions   MenuDecision[]
  recommendationEvents RecommendationEvent[]

  @@index([name])
  @@index([source])
  @@index([dishType])
  @@map("recipes")
}

model RecipeIngredient {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recipeId       String    @map("recipe_id") @db.Uuid
  recipe         Recipe    @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  rawText        String    @map("raw_text")
  rawName        String?   @map("raw_name")
  normalizedName String?   @map("normalized_name")
  canonicalName  String?   @map("canonical_name")
  amount         Decimal?  @db.Decimal
  unit           String?
  category       String?
  confidence     Decimal?  @default(0) @db.Decimal
  source         String    @default("MFDS_COOKRCP01")
  createdAt      DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime? @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@index([recipeId])
  @@index([normalizedName])
  @@unique([recipeId, rawText])
  @@map("recipe_ingredients")
}

model RecipeEmbedding {
  id                  String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recipeId            String                      @map("recipe_id") @db.Uuid
  recipe              Recipe                      @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  embeddingText       String                      @map("embedding_text")
  embedding           Unsupported("vector(1536)")
  embeddingModel      String                      @map("embedding_model")
  embeddingDimensions Int                         @default(1536) @map("embedding_dimensions")
  contentHash         String                      @map("content_hash")
  createdAt           DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([recipeId, embeddingModel, embeddingDimensions])
  @@index([recipeId])
  @@index([contentHash])
  @@map("recipe_embeddings")
}

model ImportCorrection {
  id                  String                      @id @default(cuid())
  sourceKey           String
  sourceText          String
  correctedName       String
  category            String
  storageType         String
  usageCount          Int                         @default(1)
  lastUsedAt          DateTime                    @default(now())
  embeddingText       String?
  embeddingModel      String?
  embeddingDimensions Int?
  embedding           Unsupported("vector(512)")?
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt
  userId              String
  user                User                        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sourceKey])
  @@index([userId, updatedAt])
  @@index([userId, lastUsedAt])
}

model RecommendationEvent {
  id                     String   @id @default(cuid())
  userId                 String?
  user                   User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipeId               String
  catalogRecipeId        String?  @db.Uuid
  catalogRecipe          Recipe?  @relation(fields: [catalogRecipeId], references: [id], onDelete: SetNull)
  clientEventId          String?
  eventType              String
  sessionId              String?
  rank                   Int?
  score                  Float?
  matchRate              Float?
  missingIngredientCount Int?
  urgentMatchCount       Int?
  canMakeNow             Boolean?
  source                 String?
  metadata               Json?
  createdAt              DateTime @default(now())

  @@index([userId])
  @@unique([userId, clientEventId])
  @@index([recipeId])
  @@index([catalogRecipeId])
  @@index([eventType])
  @@index([createdAt, id])
}

model MenuDecision {
  id                   String   @id @default(cuid())
  clientId             String
  decisionDate         DateTime @db.Date
  recipeKey            String
  catalogRecipeId      String?  @db.Uuid
  catalogRecipe        Recipe?  @relation(fields: [catalogRecipeId], references: [id], onDelete: SetNull)
  recipeName           String
  recommendationSource String?
  status               String   @default("selected")
  selectedAt           DateTime @default(now()) @db.Timestamptz(6)
  completedAt          DateTime? @db.Timestamptz(6)
  createdAt            DateTime @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime @updatedAt @db.Timestamptz(6)
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, decisionDate])
  @@unique([userId, clientId])
  @@index([userId, status])
  @@index([catalogRecipeId])
}

model PantryOwnership {
  id        String   @id @default(cuid())
  stapleId  String
  status    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, stapleId])
  @@index([userId, updatedAt])
}

model UserPreference {
  id                   String   @id @default(cuid())
  preferredIngredients String[] @default([])
  dislikedIngredients  String[] @default([])
  spiceLevel            String   @default("medium")
  cookingTimePreference String   @default("flexible")
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  userId                 String   @unique
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ProductEvent {
  id            String   @id @default(cuid())
  clientEventId String
  eventName     String
  route         String?
  properties    Json?
  occurredAt    DateTime @db.Timestamptz(6)
  createdAt     DateTime @default(now()) @db.Timestamptz(6)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, clientEventId])
  @@index([userId, occurredAt])
  @@index([eventName, occurredAt])
  @@index([createdAt, id])
}
