{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fridgemate-api-staging",
  "main": "server/src/worker.js",
  "compatibility_date": "2026-08-24",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "api-staging.xn--wh1bs8l5xa003adme.com/*",
      "zone_name": "xn--wh1bs8l5xa003adme.com"
    }
  ],
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [
      {
        "name": "AUTH_RATE_LIMITER",
        "class_name": "AuthRateLimiter"
      }
    ]
  },
  "exports": {
    "AuthRateLimiter": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "REPLACE_WITH_STAGING_HYPERDRIVE_ID"
    }
  ],
  "vars": {
    "NODE_ENV": "production",
    "CLIENT_ORIGIN": "https://staging.xn--wh1bs8l5xa003adme.com",
    "ALLOWED_ORIGINS": "https://staging.xn--wh1bs8l5xa003adme.com",
    "ACCESS_TOKEN_COOKIE_NAME": "__Host-fridgemate_staging_access",
    "REFRESH_TOKEN_COOKIE_NAME": "__Host-fridgemate_staging_refresh",
    "AUTH_COOKIE_SECURE": "true",
    "AUTH_COOKIE_SAME_SITE": "Lax",
    "JWT_EXPIRES_IN": "15m",
    "REFRESH_TOKEN_EXPIRES_IN": "30d",
    "RECIPE_EMBEDDING_MODEL": "text-embedding-3-small",
    "RECIPE_EMBEDDING_DIMENSIONS": "1536",
    "SEMANTIC_RECIPE_API_ENABLED": "true",
    "EXTERNAL_AI_DATA_PROCESSING_ENABLED": "false",
    "AI_USAGE_LOGGING_ENABLED": "true",
    "RECOMMENDATION_EVENTS_ENABLED": "true",
    "PRODUCT_EVENTS_ENABLED": "true",
    "IMPORT_CORRECTION_LEARNING_ENABLED": "false",
    "IMPORT_CORRECTION_EMBEDDING_ENABLED": "false",
    "API_SLOW_REQUEST_MS": "1500"
  }
}
