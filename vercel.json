{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/recipes", "destination": "/index.html" },
    { "source": "/about", "destination": "/index.html" },
    { "source": "/contact", "destination": "/index.html" },
    { "source": "/privacy", "destination": "/index.html" },
    { "source": "/ingredients", "destination": "/index.html" },
    { "source": "/ingredients/new", "destination": "/index.html" },
    { "source": "/ingredients/:ingredientId/edit", "destination": "/index.html" },
    { "source": "/import", "destination": "/index.html" },
    { "source": "/login", "destination": "/index.html" },
    { "source": "/signup", "destination": "/index.html" },
    { "source": "/account", "destination": "/index.html" }
  ]
}
