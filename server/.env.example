# Railway / production
DATABASE_URL=postgresql://DB_USER:DB_PASSWORD@DB_HOST:5432/fridgemate?schema=public

# Local server
PORT=3001
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Comma-separated list. Supports exact origins and wildcard entries such as https://*.vercel.app
ALLOWED_ORIGINS=http://localhost:5173

# Optional. If missing, the server falls back to rule-based recipe suggestions.
ANTHROPIC_API_KEY=
