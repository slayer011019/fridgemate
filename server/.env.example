# Railway / production
PORT=4000
DATABASE_URL=postgresql://DB_USER:DB_PASSWORD@DB_HOST:5432/fridgemate?schema=public

# Required. Use a strong random string such as:
# openssl rand -base64 32
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Required. Comma-separated list. Supports exact origins and wildcard entries
# such as https://*.vercel.app
ALLOWED_ORIGINS=

# Optional. Usually match the primary frontend origin.
CLIENT_ORIGIN=

# Optional. If missing, the server falls back to rule-based recipe suggestions.
ANTHROPIC_API_KEY=
